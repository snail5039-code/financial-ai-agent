# 이 파일을 `.env`(git 제외)로 복사해서 값을 채운다. 실제 키는 커밋하지 않는다.
# 서버에는 증권사 키·계좌번호를 넣지 않는다. 그 값은 사용자 폰에만 저장한다.

# PostgreSQL (docker 컨테이너 invest-db, 이미지 pgvector/pgvector:pg18)
# 테스트는 같은 서버의 invest_test DB를 만들어 쓴다.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<비밀번호>@localhost:5432/invest

# 금융감독원 OpenDART 인증키 (4단계에서 사용). https://opendart.fss.or.kr
OPENDART_API_KEY=

# 공공데이터포털 금융위원회_주식시세정보 인증키 (4단계). https://www.data.go.kr/data/15094808/openapi.do
DATA_GO_KR_API_KEY=

# 서버가 매일 분석용 데이터를 자동 수집하는 시각 (KST, 비우면 15). off면 끈다
AUTO_COLLECT_HOUR=

# Gemini API 키 (3단계부터 사용). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 비우면 gemini-3.6-flash
GEMINI_MODEL=

# 개발용: 장 운영 시간 검사를 이 시각으로 한다 (예: 10:00). 장이 닫힌 시간에 주문 흐름을 확인할 때만. 운영에서는 비운다
MARKET_CLOCK=
# 웹 개발 서버 주소 (예: http://localhost:5000). 쉼표로 여러 개
CORS_ORIGINS=
