# Copy this file to `.env` (git-ignored) and fill in real values.
# Never commit an actual key.

# 금융감독원 OpenDART API key. Free personal signup:
# https://opendart.fss.or.kr -> 회원가입 -> 인증키 신청/관리
# Leave empty to keep Company Detail's filings on the fixture placeholder.
OPENDART_API_KEY=

# 한국투자증권(KIS) Developers 모의투자(paper trading) credentials.
# 1. 한국투자증권 실계좌가 있어야 하며, HTS/MTS에서 "모의투자 참가신청"을 먼저 한다.
# 2. https://apiportal.koreainvestment.com 에서 KIS Developers 서비스를 신청하고
#    "모의투자"용 앱키/앱시크리트를 발급받는다 (실전투자용 앱키와는 다른 키).
# 3. 모의투자 계좌번호를 앞 8자리(CANO)/뒤 2자리(ACNT_PRDT_CD, 보통 "01")로 나눠 적는다.
# Leave any of these empty to keep the dashboard/approvals on the fixture
# placeholder. This app only ever calls KIS's paper-trading server
# (openapivts.koreainvestment.com) — never the real-trading domain.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_CANO=
KIS_PAPER_ACNT_PRDT_CD=
